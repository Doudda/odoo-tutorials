<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="" model="ir.ui.view">
    <field name="name">estate.property.tree</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
      <tree string="Properties">
        <field name="name"/>
        <field name="expected_price"/>
        <field name="selling_price"/>
        <field name="bedrooms"/>
        <field name="living_area"/>
        <field name="garden"/>
      </tree>
    </field>
  </record>

  <record id="view_estate_property_form" model="ir.ui.view">
    <field name="name">estate.property.form
    </field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
      <form string="Property">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="description"/>
              <field name="postcode"/>
              <field name="date_availability"/>
            </group>
            <group>
              <field name="expected_price"/>
              <field name="selling_price"/>
              <field name="bedrooms"/>
              <field name="living_area"/>
            </group>
          </group>
          <notebook>
            <page string="Garden">
              <group>
                <field name="garden"/>
                <field name="garden_area"/>
                <field name="garden_orientation"/>
              </group>
            </page>
            <page string="Other">
              <group>
                <field name="facades"/>
                <field name="garage"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_estate_property" model="ir.actions.act_window">
    <field name="name">Properties</field>
    <field name="res_model">estate.property</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_estate_property_root" name="Real Estate"/>
  <menuitem id="menu_estate_property" name="Properties" parent="menu_estate_property_root" action="action_estate_property"/>
</odoo>
